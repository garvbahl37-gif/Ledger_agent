# ── Model host ────────────────────────────────────────────────────────────────
# Ollama is tried first, then Groq, then Gemini.
#
# Fully local — no API key, no data egress. This is the configuration the
# project's privacy claim depends on; use it for confidential data.
# OLLAMA_HOST=http://localhost:11434
#
# Hosted alternative, for when the data is not sensitive and local hardware
# is not enough. Get a key at https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here

# General reasoning (A2 Proposer, A6 Reporter, A7 Adversary, A8 Meta-Agent)
OLLAMA_MODEL=gpt-oss:120b
# Code generation (A4 Executor, A9 SQL Converter)
OLLAMA_CODE_MODEL=kimi-k2.7-code
OLLAMA_TIMEOUT_S=180

# ── Optional fallbacks ────────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Telemetry database ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./ledger_telemetry.db
